# Texto
font_family monospace
font_size 12.0

# Ventana
window_padding_width 10
background_opacity 1.0

# Colores: oscuro con acento naranja
foreground #dedede
background #17191d
cursor #ff9a3c
selection_foreground #17191d
selection_background #ff9a3c

# Pestañas
tab_bar_style powerline
active_tab_foreground #17191d
active_tab_background #ff9a3c
inactive_tab_foreground #c5c5c5
inactive_tab_background #30343b

# Historial
scrollback_lines 5000
